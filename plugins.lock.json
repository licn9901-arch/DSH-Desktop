        "runtimeExternals": ["schemastery", "ws"],
        "nativeExternals": ["node-pty"],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "读写工作区文件并执行 Git 操作",
        "启动和控制本机 PTY 终端",
        "提供网页预览；桌面托管安装默认关闭 HTTP/HTTPS 接管"
      ]
    },
    {
      "package": "@dsh-desktop/settings",
      "version": "0.1.0-preview.13",
      "bundleId": "desktop-settings",
      "license": "MIT",
      "source": {
        "type": "local",
        "path": "desktop-plugins/settings"
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "原子切换精确白名单中的桌面托管 bundle，不修改依赖或卸载文件",
        "配置 Hindsight 服务、凭据状态和项目级显式启用",
        "默认安装但允许用户卸载，卸载时保留用户配置"
      ]
    },
    {
      "package": "@linxin666/dsh-client-ui-skin-center",
      "version": "0.2.6",
      "bundleId": "ui-skin-center",
      "license": "Apache-2.0",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-Qva1jjP01ca0tsaidcyQ13NhbjLi8moJ5Rjp2NgzERPRntKNrEB+iFmYwqo9tERIxazAOzfR2BXS/HsGjqEbjw=="
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "contracts",
        "skins",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml", "contracts", "skins"],
        "runtimeExternals": ["schemastery"],
        "nativeExternals": ["lightningcss"],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "加载内置皮肤与 $DSH_HOME/skins 下的用户皮肤",
        "在页面内试穿、应用和恢复皮肤，并写入 $DSH_HOME/skin-center-active.json",
        "读取用户显式选择的 Wallpaper Engine 或本机媒体目录作为背景"
      ]
    },
    {
      "package": "@vectorize-io/hindsight-coding-agents",
      "version": "0.4.1",
      "bundleId": "hindsight-coding-agents",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-kJxvHFOWalfDg7xtAuPGMRJ/v8pTGulA+8g54H/nXOjcXnqdOy/qE2EupAJaN5VCWf152Ps/X/LjXc4UVG0tSw=="
      },
      "requiredFiles": [
        "dist/dsh.js",
        "cordis.patch.yml",
        "skill/SKILL.md"
      ],
      "delivery": {
        "serverEntries": ["dist/dsh.js"],
        "clientEntries": [],
        "assets": ["cordis.patch.yml", "skill/SKILL.md"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["package.json"]
      },
      "permissions": [
        "仅对用户显式 opt-in 的 DSH 项目执行记忆 retain/recall",
        "连接用户后续配置的 Hindsight 服务"
      ]
    },
    {
      "package": "@liustack/modlens",
      "version": "3.22.1",
      "bundleId": "modlens",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-ayeyE0TBhn+Vq9gJsskUyaOXBAx8JGAJauD49nnqR+Te6S1zDcx1YqyuPmVP6LRf9bjzdfny/E+e+Ka8WN2wpw=="
      },
      "requiredFiles": [
        "dsh/index.js",
        "dsh/client.js",
        "dsh/vision-schema.json",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["dsh/index.js"],
        "clientEntries": ["dsh/client.js"],
        "assets": ["dsh/vision-schema.json", "cordis.patch.yml"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "读取用户显式提供给模型的图片",
        "调用用户配置的视觉端点或本机 Agent CLI"
      ]
    },
    {
      "package": "@cubee-slide/skills-mcp-manager",
      "version": "0.2.4",
      "bundleId": "skills-mcp-manager",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-N94gaY8ropqRNCKKO3Ff4IFIQu+EcbKC3Vrl9WFzlGxb1QnJq6H8TVMyVJaM/ir+6riuML2A2YxcBVsQeQbFAw=="
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml"],
        "runtimeExternals": ["schemastery"],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
