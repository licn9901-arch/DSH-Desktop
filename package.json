{
  "name": "dsh-desktop-tauri",
  "version": "0.1.0-preview.4",
  "private": true,
  "description": "Tauri desktop shell for DeepSeek Harness (dsh web)",
  "scripts": {
    "tauri": "tauri",
    "generate:icons": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "validate:icons": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-icons.ps1",
    "lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lib --locked --ignore-filename-regex \"(desktop|lib|main)\\.rs$\" --fail-under-lines 80",
    "smoke": "pwsh -NoProfile -File scripts/smoke-test.ps1",
    "smoke:installer": "pwsh -NoProfile -File scripts/installer-smoke.ps1",
    "stage:runtime": "pwsh -NoProfile -File scripts/stage-runtime.ps1",
    "verify:runtime": "pwsh -NoProfile -File scripts/verify-runtime.ps1",
    "stage:plugins": "pwsh -NoProfile -File scripts/stage-plugins.ps1",
    "verify:plugins": "pwsh -NoProfile -File scripts/verify-plugins.ps1",
    "release:artifacts": "pwsh -NoProfile -File scripts/write-release-artifacts.ps1",
    "dev": "npm run validate:icons && tauri dev",
    "build": "npm run validate:icons && npm run stage:runtime && npm run verify:runtime && npm run stage:plugins && npm run verify:plugins && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
